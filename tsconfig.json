{
  "$schema": "https://schemastore.org/tsconfig",
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "jsx": "react-jsx",
    "lib": ["es2023", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "dist",
    "paths": {
      "@images/*": ["./images/*"],
      "@kubevirt-extensions/*": ["src/extensions/*"],
      "@kubevirt-utils": ["src/utils"],
      "@kubevirt-utils/*": ["src/utils/*"],
      "@lightspeed/*": ["src/views/lightspeed/*"],
      "@multicluster/*": ["src/multicluster/*"],
      "@search/*": ["src/views/search/*"],
      "@settings/*": ["src/views/settings/*"],
      "@templates/*": ["src/views/templates/*"],
      "@topology/*": ["src/views/topology/*"],
      "@virtualmachines/*": ["src/views/virtualmachines/*"]
    },
    "skipLibCheck": true,
    "target": "es2023",
    "typeRoots": ["node_modules/@types", "@types"]
  },
  "include": [
    "@types/**/*",
    "src/**/*",
    "images/**/*",
    "scripts/**/*.mts",
    "plugin-metadata.ts",
    "plugin-extensions.ts",
    "knip.config.ts"
  ]
}
