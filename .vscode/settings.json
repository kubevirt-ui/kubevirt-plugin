{
  "search.exclude": {
    "**/node_modules": true,
    "package-lock.json": true
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "always"
  },
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
  "eslint.options": {
    "overrideConfigFile": "eslintv10.config.mjs"
  },
  "cSpell.words": ["hyperconverged", "kubevirt"],
  "yaml.validate": true,
  "files.associations": {
    "ci-scripts/hot-cluster/helm/**/templates/*.yaml": "helm"
  }
}
